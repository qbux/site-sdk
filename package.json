{
  "name": "@vidlove/site-sdk",
  "version": "0.1.6",
  "description": "Standalone site integration SDK for VidLove-compatible authenticated file sites.",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "test",
    "dist",
    "tsconfig.json",
    "vitest.config.ts",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
